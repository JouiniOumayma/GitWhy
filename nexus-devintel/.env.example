# =====================================================================
# NEXUS-DevIntel — local development configuration
# Copy to .env, then `docker compose up -d`.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Neo4j (Knowledge Graph)
# ---------------------------------------------------------------------
NEO4J_USER=neo4j
# Local-development password. It is shorter than the Neo4j 5 minimum of 8
# characters, which is why docker-compose.yml sets
# dbms.security.auth_minimum_password_length=4 for the container.
# Two consequences worth knowing:
#   * NEO4J_AUTH is only read when the volume is empty (first boot); on an
#     existing database, change it with:
#       ALTER CURRENT USER SET PASSWORD FROM '<old>' TO '<new>';
#   * before exposing Neo4j beyond localhost, raise this to >= 8 characters
#     and drop that setting from docker-compose.yml.
NEO4J_PASSWORD=user
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Heap/page cache for the container. Raise NEO4J_HEAP if the demo graph grows.
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M

# ---------------------------------------------------------------------
# PostgreSQL / pgvector (vector store + ingestion ledger)
# ---------------------------------------------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://nexus:nexus@localhost:5432/nexus

# ---------------------------------------------------------------------
# Ingestion / retrieval
# ---------------------------------------------------------------------
# Id of the repository to analyze, as used in every node id.
# Change this to your own repository, e.g. acme/superlib.
NEXUS_REPO_ID=owner/name
# Path to a local clone when scripts need real files (e.g. fixtures/build_fixtures.py).
NEXUS_REPO_PATH=../owner-name
# Embedding model + dimension. MUST match the vector(384) columns in
# schema/postgres/001_init.sql; changing it means re-creating the volume
# (or applying schema/postgres/002_mini.sql on an existing 1024-dim DB).
NEXUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEXUS_EMBEDDING_DIM=384
# Nodes per UNWIND batch when loading into Neo4j.
NEXUS_LOAD_BATCH_SIZE=200
NEXUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# GitHub connector (Phase 1: ingestion/github_client.py + webhook.py)
# ---------------------------------------------------------------------
# Optional for public repos: raises the rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=
# HMAC secret shared with the GitHub webhook configuration. When empty,
# the webhook server logs a warning and does NOT enforce signatures
# (local development only).
GITHUB_WEBHOOK_SECRET=
# Port the local webhook server listens on.
NEXUS_WEBHOOK_PORT=8765

# ---------------------------------------------------------------------
# Agents (Phase 3: agents/llm.py)
# ---------------------------------------------------------------------
# Priorité : Gemini > Mistral > None (mode dégradé sans LLM).
# Sans aucune clé, les agents répondent sur les seules preuves du graphe
# et escaladent au lieu de rédiger du texte.
#
# Gemini (Google AI Studio) — prioritaire
GEMINI_API_KEY=
# Mistral (repli) — utilisé uniquement si GEMINI_API_KEY est absent
MISTRAL_API_KEY=
# Modèle transmis aux clients LLM.
# Pour Gemini : gemini-2.5-flash | gemini-2.5-pro | gemini-1.5-flash
# Pour Mistral : mistral-small-latest | mistral-medium-latest
NEXUS_LLM_MODEL=gemini-2.5-flash
